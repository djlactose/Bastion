# Top-level Python dependencies for the Bastion web app.
#
# web/requirements.txt is generated from this file and pins every package,
# including transitive ones, by exact version and SHA-256 hash. Edit this
# file, then regenerate (Python 3.12, the version in the ubuntu:24.04 image):
#
#   docker run --rm -v "$PWD/web:/w" -w /w python:3.12-slim sh -c \
#     "pip install -q pip-tools && pip-compile --generate-hashes --strip-extras \
#      --output-file requirements.txt requirements.in"
#
# Dependabot understands this layout and keeps both files in step.
